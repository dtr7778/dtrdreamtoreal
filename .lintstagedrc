    "eslint --max-warnings 0 --config ./apps/tanstack-web/eslint.config.js"
  ],
  "packages/auth/**/*.{ts,tsx}": [
    "eslint --max-warnings 0 --config ./packages/auth/eslint.config.js"
  ],
  "packages/drizzle/**/*.{ts,tsx}": [
    "eslint --max-warnings 0 --config ./packages/drizzle/eslint.config.js"
  ],
  "packages/lib/**/*.{ts,tsx}": [
    "eslint --max-warnings 0 --config ./packages/lib/eslint.config.js"
  ],
  "packages/mail/**/*.{ts,tsx}": [
    "eslint --max-warnings 0 --config ./packages/mail/eslint.config.js"
  ],
  "packages/server-core/**/*.{ts,tsx}": [
