{
  "name": "@workspace/vitest-config",
  "version": "0.0.0",
  "private": true,
  "author": "DTR - Dream To Real <dream.to.real.7778@gmail.com>",
  "contributors": [
    {
      "name": "Saiful Islam",
      "email": "saiful.islam.rafi.88@gmail.com"
    }
  ],
  "license": "PROPRIETARY",
  "publishConfig": {
    "access": "restricted"
  },
  "exports": {
    "./base": {
      "types": "./dist/esm/base-config.d.ts",
      "import": "./dist/esm/base-config.js",
      "require": "./dist/cjs/base-config.js"
    },
    "./ui": {
      "types": "./dist/esm/ui-config.d.ts",
      "import": "./dist/esm/ui-config.js",
      "require": "./dist/cjs/ui-config.js"
    },
    "./internal": {
      "types": "./dist/esm/internal-config.d.ts",
      "import": "./dist/esm/internal-config.js",
      "require": "./dist/cjs/internal-config.js"
    }
  },
  "scripts": {
    "build": "pnpm build:esm && pnpm build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "dev": "tsc -p tsconfig.esm.json --watch",
    "coverage:collect": "tsx src/collect-coverage.ts",
    "coverage:merge": "nyc merge coverage/raw coverage/merged/merged-coverage.json",
    "coverage:report": "nyc report -t coverage/merged --report-dir coverage/report --reporter=html --exclude-after-remap false",
    "coverage:view": "start coverage/report/index.html"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "glob": "^13.0.6",
    "jsdom": "^30.0.1",
    "nyc": "^18.0.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
