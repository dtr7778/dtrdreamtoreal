enum ContactSubmissionStatusEnum {
  PENDING
  READ
  REPLIED
  SPAM
}

enum FeedbackIssueStatusEnum {
  OPEN
  IN_PROGRESS
  NEEDS_INFO
  RESOLVED
  CLOSED
}

enum FeedbackIssueTypeEnum {
  BUG
  FEATURE_REQUEST
  FEEDBACK
  SUGGESTION
  REPORT
  OTHER
}

enum NotificationCategoryEnum {
  SYSTEM
  AUTH
  SUPPORT
  LEAD
}

enum NotificationLevelEnum {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum RoleEnum {
  USER
  SUPPORT_AGENT
  ADMIN
  SUPER_ADMIN
}

table contact_submissions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name varchar(255) [not null]
  email varchar(255) [not null]
  subject varchar(255) [not null]
  phone varchar(50)
  company varchar(255)
  message text [not null]
  status ContactSubmissionStatusEnum [not null, default: 'PENDING']
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    email [name: 'contact_submission_email_idx']
    status [name: 'contact_submission_status_idx']
    created_at [name: 'contact_submission_created_at_idx']
  }
}

table contact_submission_replies {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  submission_id uuid [not null]
  replied_by uuid [not null]
  reply text [not null]
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    
    submission_id [name: 'contact_submission_reply_submission_id_idx']
    replied_by [name: 'contact_submission_reply_replied_by_idx']
  }
}

table feedback_issues {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  title varchar(255) [not null]
  description text [not null]
  type FeedbackIssueTypeEnum [not null]
  status FeedbackIssueStatusEnum [not null, default: 'OPEN']
  closed_at "timestamp (3) with time zone"
  created_by_id uuid [not null]
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    created_by_id [name: 'feedback_issues_createdBy_idx']
    status [name: 'feedback_issues_status_idx']
    type [name: 'feedback_issues_type_idx']
    created_at [name: 'feedback_issues_created_at_idx']
  }
}

table feedback_issue_replies {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  issue_id uuid [not null]
  content text [not null]
  created_by_id uuid [not null]
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    
    issue_id [name: 'feedback_issue_replies_issue_idx']
    created_by_id [name: 'feedback_issue_replies_createdBy_idx']
  }
}

table notifications {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  recipient_id uuid [not null]
  actor_id uuid
  category NotificationCategoryEnum [not null]
  level NotificationLevelEnum [not null, default: 'INFO']
  title varchar(255) [not null]
  message text [not null]
  data jsonb
  is_read boolean [not null, default: false]
  read_at "timestamp (3) with time zone"
  is_archived boolean [not null, default: false]
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    
    recipient_id [name: 'notifications_recipient_idx']
    (recipient_id, is_read) [name: 'notifications_recipient_read_idx']
    created_at [name: 'notifications_created_at_idx']
  }
}

table notification_settings {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  category NotificationCategoryEnum [not null]
  email_enabled boolean [not null, default: true]
  push_enabled boolean [not null, default: true]
  in_app_enabled boolean [not null, default: true]
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    (user_id, category) [name: 'notification_settings_user_category_key', unique]
  }
}

table push_subscriptions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  endpoint text [not null]
  p256dh text [not null]
  auth text [not null]
  expiration_time "double precision"
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    endpoint [name: 'push_subscription_endpoint_unique', unique]
    user_id [name: 'push_subscription_user_id']
  }
}

table permissions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name varchar(255) [not null]
  level varchar [not null]
  resource varchar [not null]
  action varchar [not null]
  description varchar(255)
  metadata jsonb
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    (level, resource, action) [name: 'permission_level_resource_action_key', unique]
    level [name: 'permission_level_idx']
    resource [name: 'permission_resource_idx']
    action [name: 'permission_action_idx']
  }
}

table roles {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  role_name RoleEnum [not null, default: 'USER']
  description varchar(255)
  metadata jsonb

  indexes {
    role_name [name: 'role_name_unique', unique]
  }
}

table role_permissions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  role_id uuid [not null]
  permission_id uuid [not null]
  created_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    
    (role_id, permission_id) [name: 'role_permission_unique', unique]
    role_id [name: 'role_permission_role_idx']
    permission_id [name: 'role_permission_permission_idx']
  }
}

table user_roles {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  role_id uuid [not null]
  user_id uuid [not null]
  assigned_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    
    (user_id, role_id) [name: 'user_role_unique']
    role_id [name: 'user_role_role_id_idx']
    user_id [name: 'user_role_user_id_idx']
  }
}

table users {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name varchar(255) [not null]
  email varchar(255) [not null]
  email_verified boolean [not null, default: false]
  image varchar(255)
  role varchar(255) [not null]
  banned boolean [default: false]
  ban_reason varchar(255)
  ban_expires "timestamp (3) with time zone"
  timezone varchar(50) [not null, default: 'UTC']
  locale varchar(10) [not null, default: 'en-US']
  currency varchar(3) [not null, default: 'USD']
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    email [name: 'user_email_key', unique]
  }
}

table user_activities {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  session_id uuid
  ip_address varchar(45)
  user_agent text
  login_at "timestamp (3) with time zone" [not null, default: `now()`]
  logout_at "timestamp (3) with time zone"
  last_seen_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    
    user_id [name: 'user_activity_user_id_idx']
    login_at [name: 'user_activity_login_at_idx']
    last_seen_at [name: 'session_activity_last_seen_at_idx']
  }
}

table accounts {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  account_id text [not null]
  provider_id text [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at "timestamp (6) with time zone"
  refresh_token_expires_at "timestamp (6) with time zone"
  scope text
  password text
  user_id uuid [not null]
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    (provider_id, account_id) [name: 'account_provider_account_id_key', unique]
    user_id [name: 'account_user_id_idx']
  }
}

table files {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  key varchar(512) [not null]
  filename varchar(255) [not null]
  original_name varchar(255) [not null]
  mime_type varchar(127) [not null]
  size bigint [not null]
  url varchar [not null]
  uploaded_by uuid
  entity_type varchar(50)
  entity_id uuid
  uploaded_at "timestamp (3) with time zone" [not null, default: `now()`]
  deleted_at "timestamp (3) with time zone"
  deleted_by uuid

  indexes {
    
    
    uploaded_by [name: 'files_user_idx']
    deleted_by [name: 'files_deleted_by_idx']
    (entity_type, entity_id) [name: 'files_entity_idx']
    key [name: 'files_key_idx']
    uploaded_at [name: 'files_uploaded_at_idx']
  }
}

table sessions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  token text [not null]
  ip_address varchar(45)
  user_agent text
  impersonated_by varchar(255)
  user_id uuid [not null]
  expires_at "timestamp (6) with time zone" [not null]
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    token [name: 'session_token_key', unique]
    user_id [name: 'session_user_id_idx']
    expires_at [name: 'session_expires_at_idx']
  }
}

table verifications {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  identifier text [not null]
  value text [not null]
  expires_at "timestamp (3) with time zone" [not null]
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]
}

ref: contact_submission_replies.submission_id > contact_submissions.id

ref: contact_submission_replies.replied_by > users.id

ref: feedback_issues.created_by_id > users.id

ref: feedback_issue_replies.issue_id > feedback_issues.id

ref: feedback_issue_replies.created_by_id > users.id

ref: notifications.recipient_id > users.id

ref: notifications.actor_id > users.id

ref: notification_settings.user_id > users.id

ref: push_subscriptions.user_id > users.id

ref: role_permissions.role_id > roles.id

ref: role_permissions.permission_id > permissions.id

ref: user_roles.role_id > roles.id

ref: user_roles.user_id - users.id

ref: user_activities.user_id - users.id

ref: user_activities.session_id > sessions.id

ref: accounts.user_id > users.id

ref: files.uploaded_by > users.id

ref: files.deleted_by > users.id

ref: sessions.user_id > users.id