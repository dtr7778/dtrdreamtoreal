ref: email_threads.id - contact_submissions.email_thread_id

ref: contact_submissions.contact_user_id > contact_users.id

ref: contact_submission_replies.submission_id - contact_submissions.id

ref: contact_submission_replies.replied_by > users.id

ref: emails.id - contact_submission_replies.email_id

ref: emails.thread_id > email_threads.id

