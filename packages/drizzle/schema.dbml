  last_name varchar(100)
  phone varchar(50)
  company varchar(255)
  metadata jsonb
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    email [name: 'contactUser_email_idx', unique]
    name [name: 'contactUser_name_idx']
    created_at [name: 'contactUser_createdAt_idx']
  }
}

table emails {
