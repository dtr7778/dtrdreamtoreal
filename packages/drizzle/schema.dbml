enum AddressTypeEnum {
  billing
  shipping
  office
  home
  work
  other
}

enum AuditItemStatusEnum {
  pending
  running
  passed
  failed
  warning
  needs_review
  error
  skipped
}

enum AuditStatusEnum {
  pending
  running
  completed
  failed
  partial
  cancelled
}

enum ContactStatusEnum {
  pending
  processing
  replied
  closed
  spam
}

enum CwvSourceEnum {
  psi
  crux
  crux_history
  bigquery
}

enum CwvStrategyEnum {
  phone
  desktop
}

enum EmailDirectionEnum {
  outbound
  inbound
  web_form
}

enum EmailEventTypeEnum {
  "email.sent"
  "email.delivered"
  "email.delivery_delayed"
  "email.bounced"
  "email.complained"
  "email.opened"
  "email.clicked"
  "email.unsubscribed"
  "email.rejected"
}

enum EmailRecipientTypeEnum {
  to
  cc
  bcc
  reply_to
  from
  received_for
}

enum EmailStatusEnum {
  draft
  queued
  sent
  received
  delivered
  delivery_delayed
  bounced
  complained
  suppressed
  failed
}

enum NotificationCategoryEnum {
  SYSTEM
  AUTH
  SUPPORT
  LEAD
}

enum NotificationLevelEnum {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum RoleEnum {
  USER
  SUPPORT_AGENT
  ADMIN
  SUPER_ADMIN
}

enum SocialMediaPlatfromTypeEnum {
  X
  linkedin
  facebook
  instagram
  youtube
  tiktok
  other
}

enum SocialMediaTypeEnum {
  person
  company
}

enum TaskPriorityEnum {
  low
  medium
  high
}

enum TaskStatusEnum {
  todo
  in_progress
  done
  cancelled
}

table contact_submissions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  email_thread_id uuid [not null]
  contact_user_id uuid [not null]
  subject varchar
  message varchar [not null]
  status ContactStatusEnum [not null, default: 'pending']
  ip_address varchar(45)
  user_agent text
  metadata jsonb
  notes text
  is_spam boolean [not null, default: false]
  spam_reason text
  read_at "timestamp (3) with time zone"
  closed_at "timestamp (3) with time zone"
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    
    contact_user_id [name: 'contactSubmission_contactUserId_idx']
    email_thread_id [name: 'contactSubmission_emailThreadId_idx', unique]
    status [name: 'contactSubmission_status_idx']
    created_at [name: 'contactSubmission_createdAt_idx']
  }
}

table contact_submission_replies {
  id uuid [pk, not null, default: `gen_random_uuid()`]
