  replied_by uuid [not null]
  email_id uuid [not null]
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    
    
    submission_id [name: 'contactSubmissionReply_submissionId_idx']
    replied_by [name: 'contactSubmissionReply_repliedBy_idx']
    email_id [name: 'contactSubmissionReply_emailId_idx', unique]
    created_at [name: 'contactSubmissionReply_createdAt_idx']
  }
}

