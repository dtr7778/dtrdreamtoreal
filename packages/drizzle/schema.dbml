enum ContactStatusEnum {
  pending
  processing
  replied
  closed
  spam
}

enum EmailDirectionEnum {
  outbound
  inbound
  web_form
}

enum EmailEventTypeEnum {
  "email.sent"
  "email.delivered"
  "email.delivery_delayed"
  "email.bounced"
  "email.complained"
  "email.opened"
  "email.clicked"
  "email.unsubscribed"
  "email.rejected"
}

enum EmailRecipientTypeEnum {
  to
  cc
  bcc
  reply_to
  from
  received_for
}

enum EmailStatusEnum {
  draft
  queued
  sent
  delivered
  bounced
  complained
  failed
}

enum NotificationCategoryEnum {
  SYSTEM
  AUTH
  SUPPORT
  LEAD
}

enum NotificationLevelEnum {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum RoleEnum {
  USER
  SUPPORT_AGENT
  ADMIN
  SUPER_ADMIN
}

enum TaskPriorityEnum {
  low
  medium
  high
}

enum TaskStatusEnum {
  todo
  in_progress
  done
  cancelled
}

table contact_submissions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  contact_user_id uuid [not null]
  subject varchar
  message text [not null]
  status ContactStatusEnum [not null, default: 'pending']
  ip_address varchar(45)
  user_agent text
  metadata jsonb
  notes text
  is_spam boolean [not null, default: false]
  spam_reason text
  read_at "timestamp (3) with time zone"
  closed_at "timestamp (3) with time zone"
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    contact_user_id [name: 'contactSubmission_contactUser_idx']
    status [name: 'contactSubmission_status_idx']
    created_at [name: 'contactSubmission_createdAt_idx']
  }
}

table contact_submission_replies {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  submission_id uuid [not null]
  replied_by uuid [not null]
  reply text [not null]
  message_id varchar
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    submission_id [name: 'contactSubmissionReply_submissionId_idx']
    message_id [name: 'contactSubmissionReply_messageId_idx']
    created_at [name: 'contactSubmissionReply_createdAt_idx']
  }
}

table contact_users {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  email varchar(320) [not null]
  name varchar(255)
  first_name varchar(100)
  last_name varchar(100)
  phone varchar(50)
  company varchar(255)
  metadata jsonb
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    email [name: 'contactUser_email_idx', unique]
    name [name: 'contactUser_name_idx']
    created_at [name: 'contactUser_createdAt_idx']
  }
}

table contact_email_joins {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  submission_id uuid [not null]
  email_id uuid [not null]
  created_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    
    submission_id [name: 'contactEmailJoin_sumissionId_idx']
    email_id [name: 'contactEmailJoin_emailId_idx']
  }
}

table emails {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  thread_id uuid
  direction EmailDirectionEnum [not null]
  status EmailStatusEnum [not null, default: 'draft']
  resend_id varchar
  resend_message_id varchar
  q_message_id varchar
  subject varchar
  text_body text
  html_body text
  headers jsonb
  metadata jsonb
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    thread_id [name: 'email_emailThreadId_idx']
    resend_id [name: 'email_resendId_idx', unique]
    q_message_id [name: 'email_qMessageId_idx', unique]
    resend_message_id [name: 'email_messageId_idx']
    direction [name: 'email_direction_idx']
    status [name: 'email_status_idx']
    created_at [name: 'email_createdAt_idx']
  }
}

table email_attachments {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  email_id uuid [not null]
  filename varchar [not null]
  content_type varchar [not null]
  content_id varchar
  content_disposition text
  size integer
  storage_key varchar
  url varchar
  created_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    email_id [name: 'emailAttachment_emailId_idx']
    content_id [name: 'emailAttachment_contentId_idx']
  }
}

table email_recipients {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  email_id uuid [not null]
  type EmailRecipientTypeEnum [not null]
  email varchar [not null]
  name varchar
  created_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    email_id [name: 'emailRecipient_emailId_idx']
    email [name: 'emailRecipient_email_idx']
    type [name: 'emailRecipient_type_idx']
  }
}

table email_threads {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  subject varchar [not null]
  contact_email varchar [not null]
  contact_name varchar
  is_closed boolean [not null, default: false]
  closed_at "timestamp (3) with time zone"
  closed_by uuid
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    closed_by [name: 'emailThread_closedBy_idx']
    contact_email [name: 'emailThread_contactEmail_idx']
    is_closed [name: 'emailThread_isClosed_idx']
  }
}

table notifications {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  recipient_id uuid [not null]
  actor_id uuid
  category NotificationCategoryEnum [not null]
  level NotificationLevelEnum [not null, default: 'INFO']
  title varchar(255) [not null]
  message text [not null]
  data jsonb
  is_read boolean [not null, default: false]
  read_at "timestamp (3) with time zone"
  is_archived boolean [not null, default: false]
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    
    recipient_id [name: 'notifications_recipient_idx']
    (recipient_id, is_read) [name: 'notifications_recipient_read_idx']
    created_at [name: 'notifications_created_at_idx']
  }
}

table permissions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name varchar(255) [not null]
  level varchar [not null]
  resource varchar [not null]
  action varchar [not null]
  description varchar(255)
  metadata jsonb
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    (level, resource, action) [name: 'permission_level_resource_action_key', unique]
    level [name: 'permission_level_idx']
    resource [name: 'permission_resource_idx']
    action [name: 'permission_action_idx']
  }
}

table roles {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  role_name RoleEnum [not null, default: 'USER']
  description varchar(255)
  metadata jsonb

  indexes {
    role_name [name: 'role_name_unique', unique]
  }
}

table role_permissions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  role_id uuid [not null]
  permission_id uuid [not null]
  created_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    
    (role_id, permission_id) [name: 'role_permission_unique', unique]
    role_id [name: 'role_permission_role_idx']
    permission_id [name: 'role_permission_permission_idx']
  }
}

table user_roles {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  role_id uuid [not null]
  user_id uuid [not null]
  assigned_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    
    (user_id, role_id) [name: 'user_role_unique']
    role_id [name: 'user_role_role_id_idx']
    user_id [name: 'user_role_user_id_idx']
  }
}

table users {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name varchar(255) [not null]
  email varchar(255) [not null]
  email_verified boolean [not null, default: false]
  image varchar(255)
  role varchar(255) [not null]
  banned boolean [default: false]
  ban_reason varchar(255)
  ban_expires "timestamp (3) with time zone"
  timezone varchar(50) [not null, default: 'UTC']
  locale varchar(10) [not null, default: 'en-US']
  currency varchar(3) [not null, default: 'USD']
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    email [name: 'user_email_key', unique]
  }
}

table user_activities {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  session_id uuid
  ip_address varchar(45)
  user_agent text
  login_at "timestamp (3) with time zone" [not null, default: `now()`]
  logout_at "timestamp (3) with time zone"
  last_seen_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    
    user_id [name: 'user_activity_user_id_idx']
    login_at [name: 'user_activity_login_at_idx']
    last_seen_at [name: 'session_activity_last_seen_at_idx']
  }
}

table notification_settings {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  category NotificationCategoryEnum [not null]
  email_enabled boolean [not null, default: true]
  push_enabled boolean [not null, default: true]
  in_app_enabled boolean [not null, default: true]
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    (user_id, category) [name: 'notification_settings_user_category_key', unique]
  }
}

table push_subscriptions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  endpoint text [not null]
  p256dh text [not null]
  auth text [not null]
  expiration_time "double precision"
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    endpoint [name: 'push_subscription_endpoint_unique', unique]
    user_id [name: 'push_subscription_user_id']
  }
}

table accounts {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  account_id text [not null]
  provider_id text [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at "timestamp (6) with time zone"
  refresh_token_expires_at "timestamp (6) with time zone"
  scope text
  password text
  user_id uuid [not null]
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    (provider_id, account_id) [name: 'account_accountProvider_accountId_idx', unique]
    user_id [name: 'account_userId_idx']
  }
}

table files {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  key varchar(512) [not null]
  filename varchar(255) [not null]
  original_name varchar(255) [not null]
  mime_type varchar(127) [not null]
  size bigint [not null]
  url varchar [not null]
  uploaded_by uuid
  entity_type varchar(50)
  entity_id uuid
  uploaded_at "timestamp (3) with time zone" [not null, default: `now()`]
  deleted_at "timestamp (3) with time zone"
  deleted_by uuid

  indexes {
    
    
    uploaded_by [name: 'file_user_idx']
    deleted_by [name: 'file_deletedBy_idx']
    (entity_type, entity_id) [name: 'file_entityType_idx']
    key [name: 'file_key_idx']
    uploaded_at [name: 'file_uploadedAt_idx']
  }
}

table sessions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  token text [not null]
  ip_address varchar(45)
  user_agent text
  impersonated_by varchar(255)
  user_id uuid [not null]
  expires_at "timestamp (6) with time zone" [not null]
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    token [name: 'session_token_idx', unique]
    user_id [name: 'session_userId_idx']
    expires_at [name: 'session_expiresAt_idx']
  }
}

table verifications {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  identifier text [not null]
  value text [not null]
  expires_at "timestamp (3) with time zone" [not null]
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]
}

table tasks {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  title varchar(255) [not null]
  description text
  status TaskStatusEnum [not null, default: 'todo']
  priority TaskPriorityEnum [not null, default: 'medium']
  due_date "timestamp (3) with time zone"
  assigned_by uuid
  created_by uuid [not null]
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    
    assigned_by [name: 'tasks_assigned_by_idx']
    status [name: 'tasks_status_idx']
    priority [name: 'tasks_priority_idx']
    due_date [name: 'tasks_due_date_idx']
    created_at [name: 'tasks_created_at_idx']
  }
}

ref: contact_submissions.contact_user_id > contact_users.id

ref: contact_submission_replies.submission_id - contact_submissions.id

ref: contact_email_joins.submission_id > contact_submissions.id

ref: contact_email_joins.submission_id > emails.id

ref: emails.thread_id > email_threads.id

ref: email_attachments.email_id > emails.id

ref: email_recipients.email_id > emails.id

ref: email_threads.closed_by > users.id

ref: notifications.recipient_id > users.id

ref: notifications.actor_id > users.id

ref: role_permissions.role_id > roles.id

ref: role_permissions.permission_id > permissions.id

ref: user_roles.role_id > roles.id

ref: user_roles.user_id - users.id

ref: user_activities.user_id - users.id

ref: user_activities.session_id > sessions.id

ref: notification_settings.user_id > users.id

ref: push_subscriptions.user_id > users.id

ref: accounts.user_id > users.id

ref: files.uploaded_by > users.id

ref: files.deleted_by > users.id

ref: sessions.user_id > users.id

ref: tasks.assigned_by > users.id

ref: tasks.created_by > users.id