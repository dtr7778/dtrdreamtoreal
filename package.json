{
  "name": "dtr-dream-to-real",
  "version": "0.0.1",
  "private": true,
  "author": "DTR - Dream To Real <dream.to.real.7778@gmail.com>",
  "contributors": [
    {
      "name": "Saiful Islam",
      "email": "saiful.islam.rafi.88@gmail.com"
    }
  ],
  "license": "PROPRIETARY",
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "prepare": "husky",
    "commit": "cz",
    "seed:storage": "tsx scripts/seed/storage.seed.ts",
    "docker:dev:up": "bash scripts/docker-compose-wrapper.sh -f ./infra/docker/docker-compose-dev.yml up -d",
    "docker:dev:down": "bash scripts/docker-compose-wrapper.sh -f ./infra/docker/docker-compose-dev.yml down",
    "test": "turbo test",
    "test:projects": "vitest run",
    "test:projects:watch": "vitest --watch"
  },
  "dependencies": {
    "@supabase/supabase-js": "catalog:"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "catalog:",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@storybook/addon-vitest": "catalog:",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.0",
      "postcss": ">=8.5.23",
      "esbuild": ">=0.25.12"
    }
  }
}
