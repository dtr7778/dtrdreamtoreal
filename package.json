    "@workspace/vitest-config": "workspace:*",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
