{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "SKIP_ENV_VALIDATION",
    "DATABASE_URL",
    "REDIS_REST_URL",
    "REDIS_REST_TOKEN",
    "NEXT_PUBLIC_GOOGLE_AUTH_CLIENT_ID",
    "GOOGLE_AUTH_CLIENT_SECRET",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_SECRET",
    "QSTASH_URL",
    "QSTASH_TOKEN",
    "QSTASH_CURRENT_SIGNING_KEY",
    "QSTASH_NEXT_SIGNING_KEY",
    "RESEND_API_KEY",
    "SUPPORT_MAIL",
    "SYSTEM_MAIL",
    "DOMAIN_NAME",
    "SUPABASE_SECRET_KEY",
    "NEXT_RUNTIME",
    "WEB_PUSH_PRIVATE_KEY",
    "SUPABASE_STORAGE_BUCKET_NAME",
    "RESEND_INBOUND_WEBHOOK_SECRET",
    "RESEND_OUTBOUND_WEBHOOK_SECRET",
    "NGROK_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@workspace/vitest-config#build": {
      "outputs": ["dist/**"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.config.ts"],
      "dependsOn": ["@workspace/vitest-config#build"],
      "outputs": []
    }
  }
}
