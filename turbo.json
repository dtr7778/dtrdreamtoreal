{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "SKIP_ENV_VALIDATION",
    "CI",
    "TRUST_PROXY",
    "DATABASE_URL",
    "REDIS_REST_URL",
    "REDIS_REST_TOKEN",
    "REDIS_URL",
    "REDIS_TLS",
    "NEXT_PUBLIC_GOOGLE_AUTH_CLIENT_ID",
    "GOOGLE_AUTH_CLIENT_ID",
    "GOOGLE_AUTH_CLIENT_SECRET",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_SECRET",
    "DOMAIN_NAME",
    "QSTASH_URL",
    "QSTASH_TOKEN",
    "QSTASH_CURRENT_SIGNING_KEY",
    "QSTASH_NEXT_SIGNING_KEY",
    "BULLMQ_SIGNING_SECRET",
    "GOOGLE_PSI_API_KEY",
    "GOOGLE_CRUX_API_KEY",
    "GOOGLE_PSI_BASE_URL",
    "GOOGLE_CRUX_BASE_URL",
    "RESEND_API_KEY",
    "SUPPORT_MAIL",
    "SYSTEM_MAIL",
    "APP_NAME",
    "SITE_URL",
    "SUPABASE_SECRET_KEY",
    "SUPABASE_URL",
    "NEXT_RUNTIME",
    "WEB_PUSH_PRIVATE_KEY",
    "SUPABASE_STORAGE_BUCKET_NAME",
    "RESEND_INBOUND_WEBHOOK_SECRET",
    "RESEND_OUTBOUND_WEBHOOK_SECRET",
    "RESEND_EVENT_WEBHOOK_SECRET",
    "NGROK_URL",
    "PORT",
    "CSRF_TOKEN",
    "API_LOG_LEVEL",
    "CORS_ORIGIN",
    "OPENROUTER_API_KEY",
    "OPENROUTER_MODEL",
    "SENTRY_DSN",
    "NEXT_PUBLIC_SENTRY_DSN",
    "SENTRY_ENVIRONMENT",
    "SENTRY_RELEASE",
    "SENTRY_TRACES_SAMPLE_RATE",
    "SENTRY_ENABLE_LOGS",
    "SENTRY_DISABLED",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_PROJECT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "@workspace/tsup-config#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist"]
    },
    "build:worker": {
      "dependsOn": ["^build", "@workspace/tsup-config#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:worker": {
      "cache": false,
      "persistent": true
    },
    "@workspace/vitest-config#build": {
      "outputs": ["dist/**"]
    },
    "@workspace/tsup-config#build": {
      "outputs": ["dist/**"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.config.ts"],
      "dependsOn": ["@workspace/vitest-config#build"],
      "outputs": []
    }
  }
}
