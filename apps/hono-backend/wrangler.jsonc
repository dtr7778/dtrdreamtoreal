{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dtrdreamtoreal-hono-backend",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "observability": {
    "enabled": true,
  },
  "dev": {
    "port": 8787,
    "local_protocol": "http",
  },
  "upload_source_maps": true,
  "workers_dev": true,
  "preview_urls": true,
  "exports": {
    "ChatHubDurableObject": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "TaskHubDurableObject": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_HUB",
        "class_name": "ChatHubDurableObject",
      },
      {
        "name": "TASK_HUB",
        "class_name": "TaskHubDurableObject",
      },
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dtrdreamtoreal-db-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations",
      "remote": false,
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "MAIL_QUEUE",
        "queue": "dtrdreamtoreal-mail-queue-local",
        "remote": false,
      },
    ],
    "consumers": [
      {
        "queue": "dtrdreamtoreal-mail-queue-local",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "max_concurrency": 5,
      },
    ],
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "dtrdreamtoreal-bucket-local",
      "remote": false,
      "local_dev": {
        "experimental_s3_credentials": {
          "accessKeyId": "local-r2-access-key-id",
          "secretAccessKey": "local-r2-secret-access-key",
        },
      },
    },
  ],
  "env": {
    "staging": {
      "name": "dtrdreamtoreal-hono-backend",
      "vars": {
        "SKIP_ENV_VALIDATION": true,
      },
      "queues": {
        "producers": [
          {
            "binding": "MAIL_QUEUE",
            "queue": "dtrdreamtoreal-mail-queue-staging",
            "remote": true,
          },
        ],
        "consumers": [
          {
            "queue": "dtrdreamtoreal-mail-queue-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 5,
            "max_concurrency": 5,
          },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dtrdreamtoreal-db-staging",
          "database_id": "d80509bc-4357-44c5-9353-7dc9ea1e5c62",
          "migrations_dir": "../../migrations",
          "remote": true,
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "CHAT_HUB",
            "class_name": "ChatHubDurableObject",
          },
          {
            "name": "TASK_HUB",
            "class_name": "TaskHubDurableObject",
          },
        ],
      },
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "dtrdreamtoreal-bucket-staging",
          "remote": true,
        },
      ],
    },
    "production": {
      "name": "dtrdreamtoreal-hono-backend",
      "vars": {
        "SKIP_ENV_VALIDATION": true,
        "BACKEND_URL": "https://api.dtrdreamtoreal.com",
        "BETTER_AUTH_URL": "https://api.dtrdreamtoreal.com",
        "COOKIE_DOMAIN": ".dtrdreamtoreal.com",
        "ENVIRONMENT": "production",
        "LOG_LEVEL": "warn",
        "MAIL_SUPPORT_EMAIL": "support@dtrdreamtoreal.com",
        "MAIL_SYSTEM_EMAIL": "notification@dtrdreamtoreal.com",
        "RESEND_BASE_URL": "https://api.resend.com",
        "TRUSTED_ORIGINS": "https://dtrdreamtoreal.com,https://app.dtrdreamtoreal.com",
        "WEB_URL": "https://dtrdreamtoreal.com",
      },
      "routes": [
        {
          "custom_domain": true,
          "pattern": "api.dtrdreamtoreal.com",
          "zone_name": "dtrdreamtoreal.com",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "MAIL_QUEUE",
            "queue": "dtrdreamtoreal-mail-queue",
            "remote": true,
          },
        ],
        "consumers": [
          {
            "queue": "dtrdreamtoreal-mail-queue",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 5,
            "max_concurrency": 5,
          },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dtrdreamtoreal-db",
          "database_id": "fc84e1cc-a96e-40fc-b62e-71f105409167",
          "migrations_dir": "../../migrations",
          "remote": true,
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "CHAT_HUB",
            "class_name": "ChatHubDurableObject",
          },
          {
            "name": "TASK_HUB",
            "class_name": "TaskHubDurableObject",
          },
        ],
      },
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "dtrdreamtoreal-bucket",
          "remote": true,
        },
      ],
    },
  },
}
