{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dtrdreamtoreal-hono-backend",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "observability": {
    "enabled": true,
  },
  "dev": {
    "port": 8787,
    "local_protocol": "http",
  },
  "upload_source_maps": true,
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dtrdreamtoreal-db-local",
      "database_id": "dd2b93c8-d3fd-4de7-8956-15b488c678f6",
    },
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatHubDurableObject"] },
  ],
  "durable_objects": {
    "bindings": [{ "name": "CHAT_HUB", "class_name": "ChatHubDurableObject" }],
  },
  "queues": {
    "producers": [
      {
        "binding": "MAIL_QUEUE",
        "queue": "dtrdreamtoreal-mail-queue-local",
      },
    ],
    "consumers": [
      {
        "queue": "dtrdreamtoreal-mail-queue-local",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "max_concurrency": 5,
      },
    ],
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "dtrdreamtoreal-bucket-local",
    },
  ],
  "env": {
    "production": {
      "name": "dtrdreamtoreal-hono-backend",
      "routes": [
        {
          "custom_domain": true,
          "pattern": "api.dtrdreamtoreal.com",
        },
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "APP_NAME": "Dream To Real",
        "LOG_LEVEL": "warn",
        "BETTER_AUTH_URL": "https://api.dtrdreamtoreal.com",
        "WEB_URL": "https://dtrdreamtoreal.com",
        "BACKEND_URL": "https://api.dtrdreamtoreal.com",
        "TRUSTED_ORIGINS": "https://dtrdreamtoreal.com,https://app.dtrdreamtoreal.com",
        "COOKIE_DOMAIN": ".dtrdreamtoreal.com",
        "MAIL_SYSTEM_EMAIL": "notification@mail.dtrdreamtoreal.com",
        "MAIL_SUPPORT_EMAIL": "support@mail.dtrdreamtoreal.com",
        "R2_BUCKET_NAME": "dtrdreamtoreal-bucket",
        "RESEND_BASE_URL": "https://api.resend.com",
        "SKIP_ENV_VALIDATION": "true",
      },
      "queues": {
        "producers": [
          {
            "binding": "MAIL_QUEUE",
            "queue": "dtrdreamtoreal-mail-queue",
          },
        ],
        "consumers": [
          {
            "queue": "dtrdreamtoreal-mail-queue",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 5,
            "max_concurrency": 5,
          },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dtrdreamtoreal-db",
          "database_id": "fc84e1cc-a96e-40fc-b62e-71f105409167",
        },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "CHAT_HUB", "class_name": "ChatHubDurableObject" },
        ],
      },
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "dtrdreamtoreal-bucket",
        },
      ],
    },
  },
}
