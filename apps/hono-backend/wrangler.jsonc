{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dtrdreamtoreal-hono-backend",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "observability": {
    "enabled": true,
  },
  "dev": {
    "port": 8787,
    "local_protocol": "http",
  },
  "upload_source_maps": true,
  "workers_dev": true,
  "preview_urls": true,
  "exports": {
    "ChatHubDurableObject": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "TaskHubDurableObject": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_HUB", "class_name": "ChatHubDurableObject" },
      { "name": "TASK_HUB", "class_name": "TaskHubDurableObject" },
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dtrdreamtoreal-db-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations",
      "remote": false,
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "MAIL_QUEUE",
        "queue": "dtrdreamtoreal-mail-queue-local",
      },
    ],
    "consumers": [
      {
        "queue": "dtrdreamtoreal-mail-queue-local",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "max_concurrency": 5,
      },
    ],
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "dtrdreamtoreal-bucket-local",
    },
  ],
  "env": {
    "staging": {
      "name": "dtrdreamtoreal-hono-backend",
      "queues": {
        "producers": [
          {
            "binding": "MAIL_QUEUE",
            "queue": "dtrdreamtoreal-mail-queue-staging",
          },
        ],
        "consumers": [
          {
            "queue": "dtrdreamtoreal-mail-queue-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 5,
            "max_concurrency": 5,
          },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dtrdreamtoreal-db-staging",
          "database_id": "d80509bc-4357-44c5-9353-7dc9ea1e5c62",
          "migrations_dir": "../../migrations",
          "remote": true,
        },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "CHAT_HUB", "class_name": "ChatHubDurableObject" },
          { "name": "TASK_HUB", "class_name": "TaskHubDurableObject" },
        ],
      },
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "dtrdreamtoreal-bucket-staging",
        },
      ],
    },
    "production": {
      "name": "dtrdreamtoreal-hono-backend",
      "routes": [
        {
          "custom_domain": true,
          "pattern": "api.dtrdreamtoreal.com",
          "zone_name": "dtrdreamtoreal.com",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "MAIL_QUEUE",
            "queue": "dtrdreamtoreal-mail-queue",
          },
        ],
        "consumers": [
          {
            "queue": "dtrdreamtoreal-mail-queue",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 5,
            "max_concurrency": 5,
          },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dtrdreamtoreal-db",
          "database_id": "fc84e1cc-a96e-40fc-b62e-71f105409167",
          "migrations_dir": "../../migrations",
          "remote": true,
        },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "CHAT_HUB", "class_name": "ChatHubDurableObject" },
          { "name": "TASK_HUB", "class_name": "TaskHubDurableObject" },
        ],
      },
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "dtrdreamtoreal-bucket",
        },
      ],
    },
  },
}
