{
  "extends": "@workspace/typescript-config/expressjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"]
    },
    "rootDirs": ["./src"],
    "outDir": "./dist",
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["./tsup.config.ts", "./src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
