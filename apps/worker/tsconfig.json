{
  "extends": "@workspace/typescript-config/expressjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDirs": ["./src"],
    "outDir": "./dist",
    "jsx": "react-jsx",
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["./src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
