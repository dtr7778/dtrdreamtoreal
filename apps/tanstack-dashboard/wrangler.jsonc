{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dtrdreamtoreal-tanstack-dashboard",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "workers_dev": true,
  "preview_urls": true,
  "services": [
    {
      "binding": "AUTH",
      "service": "dtrdreamtoreal-hono-backend",
      "entrypoint": "AuthEntrypoint",
      "remote": false,
    },
    {
      "binding": "TASK",
      "service": "dtrdreamtoreal-hono-backend",
      "entrypoint": "TaskEntrypoint",
      "remote": false,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dtrdreamtoreal-db-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations",
      "remote": false,
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "MAIL_QUEUE",
        "queue": "dtrdreamtoreal-mail-queue-local",
        "remote": false,
      },
    ],
  },
  "env": {
    "staging": {
      "name": "dtrdreamtoreal-tanstack-dashboard",
      "vars": {
        "SKIP_ENV_VALIDATION": true,
      },
      "queues": {
        "producers": [
          {
            "binding": "MAIL_QUEUE",
            "queue": "dtrdreamtoreal-mail-queue-staging",
            "remote": true,
          },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dtrdreamtoreal-db-staging",
          "database_id": "d80509bc-4357-44c5-9353-7dc9ea1e5c62",
          "migrations_dir": "../../migrations",
          "remote": true,
        },
      ],
      "services": [
        {
          "binding": "AUTH",
          "service": "dtrdreamtoreal-hono-backend",
          "entrypoint": "AuthEntrypoint",
          "remote": true,
        },
        {
          "binding": "TASK",
          "service": "dtrdreamtoreal-hono-backend",
          "entrypoint": "TaskEntrypoint",
          "remote": true,
        },
      ],
    },
    "production": {
      "name": "dtrdreamtoreal-tanstack-dashboard",
      "vars": {
        "SKIP_ENV_VALIDATION": true,
        "ENVIRONMENT": "production",
        "VITE_ENVIRONMENT": "production",
        "VITE_APP_NAME": "Dream To Real",
        "VITE_SITE_URL": "https://dtrdreamtoreal.com",
        "VITE_BACKEND_URL": "https://api.dtrdreamtoreal.com",
        "VITE_AUTH_URL": "https://api.dtrdreamtoreal.com",
        "VITE_SYSTEM_MAIL": "notification@mail.dtrdreamtoreal.com",
        "VITE_SUPPORT_MAIL": "support@mail.dtrdreamtoreal.com",
      },
      "routes": [
        {
          "custom_domain": true,
          "pattern": "app.dtrdreamtoreal.com",
          "zone_name": "dtrdreamtoreal.com",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "MAIL_QUEUE",
            "queue": "dtrdreamtoreal-mail-queue",
            "remote": true,
          },
        ],
      },
      "services": [
        {
          "binding": "AUTH",
          "service": "dtrdreamtoreal-hono-backend",
          "entrypoint": "AuthEntrypoint",
          "remote": true,
        },
        {
          "binding": "TASK",
          "service": "dtrdreamtoreal-hono-backend",
          "entrypoint": "TaskEntrypoint",
          "remote": true,
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dtrdreamtoreal-db",
          "database_id": "fc84e1cc-a96e-40fc-b62e-71f105409167",
          "migrations_dir": "../../migrations",
          "remote": true,
        },
      ],
    },
  },
}
