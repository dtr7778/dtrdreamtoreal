  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "pnpm run build && vite preview",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "deploy": "CLOUDFLARE_ENV=production pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types --config=\"wrangler.jsonc\" --config=\"../hono-backend/wrangler.jsonc\" --env-file=\".env.local\"",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
