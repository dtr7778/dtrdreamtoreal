# development envs
SRH_MODE=env
SRH_TOKEN="local_redis_token"
SRH_CONNECTION_STRING="redis://default:12345678@redis:6379"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_SECRET_KEY=

# production envs
# DATABASE_URL=

SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_DISABLED=false
SENTRY_SPOTLIGHT=false
# Build-time only (source map upload)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
